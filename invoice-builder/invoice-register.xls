<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Invoice Register</title>
  </head>
  <body>
    <table>
      <tr>
        <th>Invoice Number</th>
        <th>Status</th>
        <th>Customer Name</th>
        <th>Customer Email</th>
        <th>Issue Date</th>
        <th>Due Date</th>
        <th>Currency</th>
        <th>Subtotal</th>
        <th>VAT</th>
        <th>Total</th>
        <th>Seller</th>
        <th>Saved At</th>
      </tr>
      <tr>
        <td>AB-2026-0001</td>
        <td>Draft</td>
        <td>Example Customer</td>
        <td>customer@example.com</td>
        <td>2026-05-03</td>
        <td>2026-05-17</td>
        <td>GBP</td>
        <td>450.00</td>
        <td>0.00</td>
        <td>450.00</td>
        <td>Amine Belmejdoub</td>
        <td>2026-05-03T12:00:00Z</td>
      </tr>
    </table>
  </body>
</html>
